# Postgres (Neon). Used by every workspace.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OpenAI — summaries and the `ask` agent.
OPENAI_API_KEY=sk-proj-...

# Clerk. `bash scripts/setup.sh` walks through creating these.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# GitHub org that gates access. Members of this org may sign in; nobody else.
GITHUB_ORG=crafter-station

# Comma-separated GitHub logins that are always admins. Org owners get admin
# automatically, but that is only visible when the read:org scope is configured —
# this is how the first admin exists before then.
ADMIN_GITHUB_LOGINS=

# Shared secret between apps/web and apps/ingestor for the internal control API.
INGESTOR_URL=http://localhost:8787
INGESTOR_TOKEN=generate-a-long-random-string

# Public origin of the web app. Used for MCP OAuth metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
