{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"jsx": "preserve",
		"types": ["node"],
		"allowJs": true,
		"incremental": true,
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"paths": { "@/*": ["./*"] },
		"plugins": [{ "name": "next" }]
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
